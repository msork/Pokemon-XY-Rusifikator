{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00003","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"d75ef8c12f76833f88ecf762c7aa57a59ad4bce36d906b257a317fee7d51b3a5","status":"draft","translation_segments":[{"text":"...И переодел(а)ся из"},{"control_words":["0010","0003","1100","00FF","0202"]},{"text":" пижамы!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00011","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"0af408e578ef2d039e183f5b5a2477a110e8a327c270ce23218ce904905587a1","status":"draft","translation_segments":[{"control_words":["0010","0002","0100","0000"]},{"text":"!"},{"control_words":["000A"]},{"text":"Похоже, ты только что встал(а) с постели!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Посмотри в зеркало,"},{"control_words":["000A"]},{"text":"и переоденься из пижамы."}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00012","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"8ef7211aa09ce1d0c2762e9a8864bcc0fc55fd0775803f7669f99dd31f60af34","status":"draft","translation_segments":[{"text":"Посмотри в зеркало,"},{"control_words":["000A"]},{"text":"и переоденься из пижамы."}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00014","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"a71df827b7637d1cd1e7f95bf943b89be31ea224986073b3ad41f0adac52034b","status":"draft","translation_segments":[{"text":"Не разбуди Райхорна, ладно?"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00015","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"85accd672302f61f4dc8e7136dd41e6efd4d1f04892c3abafb419d024c61a169","status":"draft","translation_segments":[{"text":"Правда? Соседские ребята пригласили"},{"control_words":["000A"]},{"text":"тебя в соседний город?"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Здорово! Как хорошо, что у тебя"},{"control_words":["000A"]},{"text":"так быстро появились друзья!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Ладно! Веселись!"},{"control_words":["000A"]},{"text":"И не попадай в неприятности!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00017","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"a886ca00f6e0d0e282b6c44b521271afa6823c6f21d3214b16384375a95718b0","status":"draft","translation_segments":[{"text":"Ну! Чем вы с соседскими ребятами"},{"control_words":["000A"]},{"text":"занимались?"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00018","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"edfb4146bb617c585dc563aae264e6f97ec17cf84e0abfbb81077d4be8ab0c04","status":"draft","translation_segments":[{"text":"Постой, "},{"control_words":["0010","0002","0100","0000"]},{"text":"!"},{"control_words":["000A"]},{"text":"Это у тебя Покебол?"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"У тебя теперь есть свой Покемон?"},{"control_words":["000A"]},{"text":"Вот здорово!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Теперь ты тоже тренер покемонов!"},{"control_words":["000A"]},{"text":"Поздравляю!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00019","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"c3629ba4f8515380229b9b219c6c41243601584fad2359c04d8b5f9a1b7c1564","status":"draft","translation_segments":[{"text":"А?"},{"control_words":["000A"]},{"text":"Письмо для меня?"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Оно от некоего Сикамора."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Что же там? Любовное письмо?"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00021","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"8e004c244cc96974252d1b0c72b943a3793e67d720f513e46113f95ea0a2b692","status":"draft","translation_segments":[{"text":"Вот это почерк..."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Хм? Что тут?"},{"control_words":["000A"]},{"text":"Просьба..."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"А, понятно!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00022","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"e45a697fcca4893699b0ae7ca13323ffed0178e429489e92a7581e02d4d6b484","status":"draft","translation_segments":[{"control_words":["0010","0002","0100","0000"]},{"text":"!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Мы ведь только-только распаковали вещи,"},{"control_words":["000A"]},{"text":"а уже столько всего происходит!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Хорошо! Давай соберём тебя и "},{"control_words":["0010","0002","0101","0001"]},{"text":" в путь"},{"control_words":["000A"]},{"text":"!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00023","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"cdb23212d8ab97fccb7e54dfc3c1319ff60e753d2d8cecc4f1b128bf4421eded","status":"draft","translation_segments":[{"text":"Вот, держи, "},{"control_words":["0010","0002","0100","0000"]},{"text":"."},{"control_words":["000A"]},{"text":"Я ещё положила тебе сменную одежду."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Ну и неожиданно всё повернулось!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Прямо как последний рывок"},{"control_words":["000A"]},{"text":"на гонках Райхорнов!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"У тебя появились друзья!"},{"control_words":["000A"]},{"text":"Ты встретил(а) своего Покемона!"},{"control_words":["0010","0001","BE00"]},{"control_words":["000A"]},{"text":"И теперь отправишься в путь по Калосу!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00024","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"3c3583ca954d36d9ca493709c9c1c29309cbf4da39d7df7a0db06cfb3ea3789a","status":"draft","translation_segments":[{"text":"О, и вот ещё!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00025","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"84e9724386726efb6a6aa1dc49650e26e009f9dceaa07bf449c7eb8c5de00292","status":"draft","translation_segments":[{"text":"Ты знаешь, как пользоваться картой города?"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00027","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"fa6ca225c6bac2366a5ba47620c70a320862075c62ad0c347ad6757565960166","status":"draft","translation_segments":[{"text":"Нажми X, чтобы открыть сумку."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Затем нажми + на крестовине и выбери"},{"control_words":["000A"]},{"text":"карман ВАЖНЫЕ ПРЕДМЕТЫ."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Выбери карту города — и путешествие"},{"control_words":["000A"]},{"text":"по Калосу станет проще простого!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0055/00:00028","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"0c2afb502a0e43c7728805968c81a48ad3aa7ff7a8d6cdbb769641c23eaa77d8","status":"draft","translation_segments":[{"text":"Не знаю, что профессор Сикамор"},{"control_words":["000A"]},{"text":"хочет показать тебе во время путешествия..."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Но странствовать вместе со своим Покемоном"},{"control_words":["000A"]},{"text":"— это прекрасный опыт."}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0057/00:00004","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"ea39b16d02ab9dfb780e1824eb7d0b43a3d3694ffbc68287c592caba233ebdcb","status":"draft","translation_segments":[{"text":"Знаменитый профессор Сикамор"},{"control_words":["000A"]},{"text":"живёт здесь, в Калосе."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Мне сказали, что он позвал пятерых ребят,"},{"control_words":["000A"]},{"text":"включая нас."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Но я удивлена, что он знает о тебе."},{"control_words":["000A"]},{"text":"Ты ведь только недавно переехал(а) в Ванивилл."}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0057/00:00005","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"48dbfa66c4c89081a6c6195cd9bf428479297432ab27f4eb5824c50f39fb032b","status":"draft","translation_segments":[{"text":"Известный профессор Сикамор"},{"control_words":["000A"]},{"text":"живёт здесь, в Калосе."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Я слышал(а), он поручил дело пятерым ребятам, включая нас."},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Но я удивлён(а), что он знает о тебе."},{"control_words":["000A"]},{"text":"Ты ведь только недавно переехал(а) в Ванивилл."}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0057/00:00007","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"876add0f79e638a7f86ca4df5dbbf15916e11e907ced4b6da48c135507e78ef7","status":"draft","translation_segments":[{"text":"Грр... Грру..."}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0057/00:00008","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"d45c0157948e92ed6ff242c5699430cf96c0bf95051644ef18c8e73f3aa097a4","status":"draft","translation_segments":[{"text":"Р-р-а-а!"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0057/00:00009","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"f21d2cbd6739f5a47b480766735fed3888a705e726e89284c5c201b8385be430","status":"draft","translation_segments":[{"text":"Что это сейчас было?"}],"version_scope":["base"]}
{"context":"opening home/neighbor dialogue","record_id":"gen6:a/0/8/2:0057/00:00010","review_note":"Project-authored draft; requires human linguistic review and owner runtime testing.","scope":"shared","source_variant_sha256":"21411d85d1e18b098001ad32e041670004e267731b286487eea090f3318ed9e8","status":"draft","translation_segments":[{"text":"Ха-ха-ха! Вот шутник!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Наверное, Райхорн просто решил"},{"control_words":["000A"]},{"text":"громко проводить тебя в путь!"},{"control_words":["0010","0001","BE01"]},{"control_words":["000A"]},{"text":"Он ведь знает тебя с самого рождения,"},{"control_words":["000A"]},{"text":"в конце концов!"}],"version_scope":["base"]}
